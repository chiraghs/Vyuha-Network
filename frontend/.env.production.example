# Copy to .env.production and fill in before building for Catalyst.
#
# The AppSail backend URL (no trailing /api — the client appends it).
# Get this from `catalyst deploy` output or the AppSail console.
VITE_API_BASE_URL=https://vyuha-api-XXXXXXXXX.development.catalystappsail.com

# Set to "true" once Catalyst Zia AI is enabled on the backend
# (CATALYST_AI_ENABLED=true there). Turns on server-backed face search,
# OCR document scan, and chat sentiment/keyword chips in the UI.
VITE_CATALYST_AI=false
